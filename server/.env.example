PORT=8080
PUBLIC_URL=http://127.0.0.1:8080

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Bot token from BotFather, shaped 123456:secret. Redirect is /v1/auth/telegram/callback.
TELEGRAM_BOT_TOKEN=

# OAuth 2.0 client from the X developer portal. Redirect is /v1/auth/x/callback.
X_CLIENT_ID=
X_CLIENT_SECRET=

# WhatsApp Cloud API. The template must be an authentication template whose body and button carry the code.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=leca_login

# Or Twilio's WhatsApp sender, for example whatsapp:+14155238886.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Set to 1 only on a private test machine. The live server leaves this unset.
# LECA_DEV_OTP=

# Routes API key. Arrival times use TRAFFIC_AWARE, so a jam changes the minutes.
GOOGLE_MAPS_API_KEY=
